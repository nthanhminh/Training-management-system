    // Hàm hiển thị notification
    function showNotification(type, title, message) {
      const container = document.getElementById('notificationContainer');
      const notification = document.createElement('div');
      notification.className = `notification ${type}`;
      
      let icon = '';
      switch(type) {
        case 'success':
          icon = 'fa-check-circle';
          break;
        case 'error':
          icon = 'fa-exclamation-circle';
          break;
        case 'warning':
          icon = 'fa-exclamation-triangle';
          break;
      }
      
      notification.innerHTML = `
        <i class="fas ${icon}"></i>
        <div class="notification-content">
          <div class="notification-title">${title}</div>
          <div class="notification-message">${message}</div>
        </div>
        <button class="notification-close">
          <i class="fas fa-times"></i>
        </button>
      `;
      
      container.appendChild(notification);
      
      // Tự động ẩn sau 5 giây
      setTimeout(() => {
        notification.style.animation = 'fadeOut 0.3s ease-out';
        setTimeout(() => {
          container.removeChild(notification);
        }, 300);
      }, 5000);
      
      // Xử lý nút đóng
      notification.querySelector('.notification-close').addEventListener('click', () => {
        notification.style.animation = 'fadeOut 0.3s ease-out';
        setTimeout(() => {
          container.removeChild(notification);
        }, 300);
      });
    }

    // Hàm validate ngày tháng
    function validateDate(dateStr) {
      console.log('Validating date:', dateStr);
      
      // Kiểm tra định dạng cơ bản
      const regex = /^(\d{2})\/(\d{2})\/(\d{4})$/;
      if (!regex.test(dateStr)) {
        console.log('Invalid format');
        return false;
      }

      // Lấy ngày, tháng, năm
      const [_, day, month, year] = dateStr.match(regex);
      console.log('Parsed date:', { day, month, year });

      // Kiểm tra giá trị hợp lệ
      const dayNum = parseInt(day);
      const monthNum = parseInt(month);
      const yearNum = parseInt(year);

      if (dayNum < 1 || dayNum > 31 || monthNum < 1 || monthNum > 12) {
        console.log('Invalid day or month');
        return false;
      }

      // Kiểm tra ngày hợp lệ trong tháng
      const date = new Date(yearNum, monthNum - 1, dayNum);
      const isValid = date.getDate() === dayNum && 
                     date.getMonth() === monthNum - 1 && 
                     date.getFullYear() === yearNum;

      console.log('Date validation result:', isValid);
      return isValid;
    }

